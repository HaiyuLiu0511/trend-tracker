# ============================================================
# .gitignore — Personal Investment Research System
# Artifact Protection (WP7)
# ============================================================
# Principle: Generated artifacts never enter Git.
# Only source code, documentation, and static configuration are tracked.
# See: docs/core/ARTIFACT_MANAGEMENT.md
# ============================================================


# --- 1. Generated Artifacts ---

# HTML reports (generated by Daily Briefing, Research Terminal, etc.)
*.html

# JSON data output (generated by pipeline runs, API responses, etc.)
*.json

# Exception: static configuration files that require version control
!config/*.json

# Generated report directories
reports/
output/
artifacts/

# Generated examples (not milestone examples)
examples/generated/

# Trend Tracker legacy data output (supersedes v1.4-era trend_data/weekly/*.json)
trend_data/


# --- 2. Temporary Files ---

tmp/
*.tmp
*.bak
*.swp
*~


# --- 3. Cache ---

# Python bytecode cache
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.so

# General cache
.cache/
*.cache

# Python packaging
*.egg-info/
dist/
build/
*.egg


# --- 4. Logs ---

*.log
logs/


# --- 5. Local Runtime ---

# Runtime output directory
runtime/

# Environment & secrets
.env
.env.*
!.env.example

# SQLite databases (generated at runtime)
*.db
*.sqlite
*.sqlite3

# Virtual environments
venv/
env/
.venv/


# --- 6. IDE Files ---

.vscode/
.idea/
*.iml
*.ipr
*.iws
.project
.pydevproject
.settings/


# --- 7. OS Files ---

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini


# ============================================================
# End of .gitignore
# ============================================================
